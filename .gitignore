.bdep/

# Local default options files.
#
.build2/local/

# Compiler/linker output.
#
# Note that *.exe.dlls directories can be symlinks thus
# no trailing /.
#
*.d
*.t
*.i
*.i.*
*.ii
*.ii.*
*.o
*.obj
*.gcm
*.pcm
*.ifc
*.so
*.dylib
*.dll
