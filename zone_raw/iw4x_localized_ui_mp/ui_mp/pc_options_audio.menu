{
  menuDef
  {
    name                        "pc_options_audio"
    rect                        0 0 640 480 0 0
    focuscolor                  1 1 1 1
    fadeClamp                   1
    fadeCycle                   1
    fadeAmount                  0.1
    blurWorld                   7
    onOpen
    {
      setLocalVarInt ui_optionsSection 2;
      setLocalVarBool ui_hideBack 1;
      if (!localvarint("ui_showAudioApply"))
      {
        exec "setfromdvar ui_snd_khz		snd_khz";
        exec "setfromdvar ui_snd_enableEq	snd_enableEq";
        exec "setfromdvar ui_outputConfig	snd_outputConfiguration";
      }
      ExecNow "profile_menuDvarsSetup; resetViewport";
    }
    onClose
    {
      setLocalVarBool ui_optionRowShow 0;
      setLocalVarBool ui_hideBack 0;
    }
    onESC
    {
      close self;
      open main_options;
      if (!(menuisopen("main_options") || menuisopen("pc_options_advanced_video") || menuisopen("pc_options_video") || menuisopen("pc_options_Audio") || menuisopen("pc_options_controls") || menuisopen("pc_options_voice") || menuisopen("pc_options_chat")) && localvarbool("ui_showPicApply") && !localvarbool("ui_showApply") && !localvarbool("ui_showAudioApply"))
      {
        execnow "setfromdvar r_picmip ui_r_picmip";
        execnow "setfromdvar r_picmip_bump ui_r_picmip_bump";
        execnow "setfromdvar r_picmip_spec ui_r_picmip_spec";
        execnow "setfromdvar r_picmip_manual ui_r_picmip_manual";
        exec "wait; wait; r_applyPicmip";
        setLocalVarBool ui_showPicApply 0;
      }
      if (!(menuisopen("main_options") || menuisopen("pc_options_advanced_video") || menuisopen("pc_options_video") || menuisopen("pc_options_Audio") || menuisopen("pc_options_controls") || menuisopen("pc_options_voice") || menuisopen("pc_options_chat")) && (localvarbool("ui_showApply") || localvarbool("ui_showAudioApply")))
      {
        open all_restart_popmenu;
      }
      ExecNow "profile_menuDvarsFinish; resetViewport";
    }
    itemDef
    {
      rect                        -427 -240 854 480 2 2
      style                       3
      decoration
      visible                     when(FUNC_29() && (dvarstring(gameMode) == "mp" || (dvarstring(gameMode) == "so" && !dvarbool(solo_play))));
      textscale                   0.55
      forecolor                   0 0 0 0.4
      background                  "white"
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      background                  "mw2_main_background"
    }
    itemDef
    {
      rect                        0 0 1708 480 0 0
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      forecolor                   1 1 1 0.5
      background                  "mw2_main_cloud_overlay"
      exp rect x                  (0 - 107) - ((float(milliseconds() % 60000) / 60000) * (854));
    }
    itemDef
    {
      rect                        0 0 -1708 -480 0 0
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      forecolor                   1 1 1 0.5
      background                  "mw2_main_cloud_overlay"
      exp rect x                  (- 107 + 854) + ((float(milliseconds() % 50000) / 50000) * (854));
    }
    itemDef
    {
      rect                        -427 -240 854 480 2 2
      style                       3
      decoration
      visible                     when(dvarstring(gameMode) == "sp" && !FUNC_29());
      textscale                   0.55
      background                  "mw2_main_sp_image"
    }
    itemDef
    {
      rect                        -427 -240 854 480 2 2
      style                       3
      decoration
      visible                     when(dvarstring(gameMode) == "so" && !FUNC_29());
      textscale                   0.55
      background                  "mw2_main_co_image"
    }
    itemDef
    {
      rect                        -427 -240 854 480 2 2
      style                       3
      decoration
      visible                     when(dvarstring(gameMode) == "mp" && !FUNC_29());
      textscale                   0.55
      background                  "mw2_main_mp_image"
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     1
      textscale                   0.55
      forecolor                   1 1 1 0
      background                  "mockup_bg_glow"
      exp forecolor a             ((sin(milliseconds() / 1500) + 1) * 0.25) + 0.25;
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     1
      textscale                   0.55
      forecolor                   1 1 1 0
      background                  "mockup_bg_glow"
      exp forecolor a             ((sin(milliseconds() / 480) + 1) * 0.25) + 0.25;
    }
    itemDef
    {
      rect                        -64 0 280 480 1 0
      style                       3
      decoration
      visible                     when(1);
      textscale                   0.55
      forecolor                   1 1 1 0.1
      background                  "gradient_fadein_fadebottom"
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      forecolor                   0.25 0.25 0.25 0.75
      background                  "gradient_fadein"
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      forecolor                   0.25 0.25 0.25 0.75
      background                  "gradient_fadein"
    }
    itemDef
    {
      text                        "@PLATFORM_BACK_CAPS"
      group                       "mw2_button"
      rect                        -64 -4 280 20 1 3
      style                       1
      type                        1
      visible                     when(1);
      textalign                   6
      textalignx                  -4
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      background                  "popup_button_selection_bar"
      onFocus
      {
        play mouse_over;
        if (dvarstring(gameMode) != "mp")
        {
          setItemColor mw2_button backcolor 0 0 0 0;
        }
        setItemColor self backcolor 0 0 0 1;
        setLocalVarBool ui_menuAButton 1;
        setLocalVarBool ui_optionRowShow 0;
      }
      leaveFocus
      {
        setItemColor self backcolor 0 0 0 "0.0";
        setLocalVarString ui_hint_text "@NULL_EMPTY";
        setLocalVarBool ui_menuAButton 0;
      }
      action
      {
        play mouse_click;
        play mouse_click;
        escape self;
        if (!(menuisopen("main_options") || menuisopen("pc_options_advanced_video") || menuisopen("pc_options_video") || menuisopen("pc_options_Audio") || menuisopen("pc_options_controls") || menuisopen("pc_options_voice") || menuisopen("pc_options_chat")))
        {
          if (localvarbool("ui_showPicApply") && !localvarbool("ui_showApply"))
          {
            execnow "setfromdvar r_picmip ui_r_picmip";
            execnow "setfromdvar r_picmip_bump ui_r_picmip_bump";
            execnow "setfromdvar r_picmip_spec ui_r_picmip_spec";
            execnow "setfromdvar r_picmip_manual ui_r_picmip_manual";
            exec "wait; wait; r_applyPicmip";
            setLocalVarBool ui_showPicApply 0;
          }
          if (localvarbool("ui_showApply") || localvarbool("ui_showAudioApply"))
          {
            open all_restart_popmenu;
          }
        }
      }
    }
    itemDef
    {
      rect                        -64 0 280 20 1 1
      style                       3
      decoration
      visible                     when(localvarbool("ui_optionRowShow"));
      textscale                   0.55
      forecolor                   0 0 0 1
      background                  "popup_button_selection_bar"
      exp rect y                  localvarfloat("ui_optionRowY");
    }
    itemDef
    {
      text                        "@MENU_DISABLED"
      rect                        -64 88 384 20 1 1
      decoration
      visible                     when(!dvarbool(ui_multiplayer));
      textalign                   4
      textalignx                  288
      textscale                   0.375
      textfont                    3
      onFocus
      {
        play mouse_over;
        setLocalVarFloat ui_optionRowY 88;
        setLocalVarBool ui_optionRowShow 1;
      }
      leaveFocus
      {
        setLocalVarBool ui_optionRowShow 0;
      }
      action
      {
        play mouse_click;
      }
      exp forecolor a             !int(getprofiledata("subtitles"));
    }
    itemDef
    {
      text                        "@MENU_ENABLED"
      rect                        -64 88 384 20 1 1
      decoration
      visible                     when(!dvarbool(ui_multiplayer));
      textalign                   4
      textalignx                  288
      textscale                   0.375
      textfont                    3
      onFocus
      {
        play mouse_over;
        setLocalVarFloat ui_optionRowY 88;
        setLocalVarBool ui_optionRowShow 1;
      }
      leaveFocus
      {
        setLocalVarBool ui_optionRowShow 0;
      }
      action
      {
        play mouse_click;
      }
      exp forecolor a             int(getprofiledata("subtitles"));
    }
    itemDef
    {
      rect                        -64 88 384 20 1 1
      type                        1
      visible                     when(!dvarbool(ui_multiplayer));
      textalign                   4
      textalignx                  288
      textscale                   0.375
      textfont                    3
      onFocus
      {
        play mouse_over;
        setLocalVarFloat ui_optionRowY 88;
        setLocalVarBool ui_optionRowShow 1;
      }
      leaveFocus
      {
        setLocalVarBool ui_optionRowShow 0;
      }
      action
      {
        play mouse_click;
        exec profile_toggleSubtitles;
      }
    }
    itemDef
    {
      text                        "@MENU_SOUND"
      rect                        0 0 272 28 1 1
      decoration
      visible                     1
      textalign                   6
      textalignx                  -60
      textscale                   0.5
      textfont                    9
    }
    itemDef
    {
      rect                        224 31 344 20 1 1
      type                        10
      visible                     when(1);
      textscale                   0.55
      onFocus
      {
        setLocalVarFloat ui_optionRowY 28;
        setLocalVarBool ui_optionRowShow 1;
        play mouse_over;
      }
      leaveFocus
      {
        setLocalVarBool ui_optionRowShow 0;
      }
      action
      {
        ExecNow profile_menuDvarsFinish;
      }
      dvarFloat                   "profileMenuOption_volume" 0.8 0 0.8
    }
    itemDef
    {
      text                        "@MENU_MASTER_VOLUME"
      rect                        -64 28 336 20 1 1
      decoration
      visible                     when(1);
      textalign                   6
      textalignx                  -60
      textscale                   0.375
      textfont                    3
    }
    itemDef
    {
      rect                        -64 48 384 20 1 1
      type                        12
      visible                     when(1);
      disabled                    when(FUNC_31());
      textalign                   4
      textalignx                  288
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      onFocus
      {
        play mouse_over;
        setLocalVarFloat ui_optionRowY 48;
        setLocalVarBool ui_optionRowShow 1;
      }
      leaveFocus
      {
        setLocalVarBool ui_optionRowShow 0;
      }
      action
      {
        play mouse_click;
        setLocalVarBool ui_showAudioApply 1;
      }
      dvar                        "ui_outputConfig"
      dvarStrList                 { "@MENU_WINDOWS_DEFAULT" "Windows default" "@MENU_MONO" "Mono" "@MENU_STEREO" "Stereo" "@MENU_FOUR_SPEAKERS" "4 speakers" "@MENU_FIVE_ONE_SPEAKERS" "5.1 speakers" }
    }
    itemDef
    {
      text                        "@MENU_SPEAKER_CONFIG"
      rect                        -64 48 336 20 1 1
      decoration
      visible                     when(1);
      disabled                    when(FUNC_31());
      textalign                   6
      textalignx                  -60
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
    }
    itemDef
    {
      text                        "@MENU_SUBTITLES"
      rect                        -64 88 336 20 1 1
      decoration
      visible                     when(!dvarbool(ui_multiplayer));
      textalign                   6
      textalignx                  -60
      textscale                   0.375
      textfont                    3
    }
  }
}
