    fadeAmount                  0.1
    blurWorld                   7
    onOpen
    {
      setLocalVarBool ui_hideBack 1;
    }
    onClose
    {
      setLocalVarBool ui_optionRowShow 0;
      setLocalVarBool ui_hideBack 0;
    }
    onESC
    {
      close self;
      if (localvarbool("ui_optionsFromControls"))
      {
        setLocalVarBool ui_optionsFromControls 0;
        open pc_options_controls;
      }
    }
