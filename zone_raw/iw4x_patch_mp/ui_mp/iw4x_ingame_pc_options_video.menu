{
  menuDef
  {
    name                        "iw4x_ingame_pc_options_video"
    rect                        0 0 640 480 0 0
    focuscolor                  1 1 1 1
    fadeClamp                   1
    fadeCycle                   1
    fadeAmount                  0.1
    blurWorld                   7
    onOpen
    {
      setLocalVarInt ui_optionsSection 1;
      ExecNow "profile_menuDvarsSetup; resetViewport";
      setLocalVarBool ui_hideBack 1;
      if (!localvarint("ui_showApply") && !localvarint("ui_showPicApply"))
      {
        exec "exec options_graphics.cfg";
      }
      ExecNow "profile_menuDvarsSetup; resetViewport";
      execOnDvarIntValue r_displayMode 0 "set ui_r_displayMode 0";
      execOnDvarIntValue r_displayMode 1 "set ui_r_displayMode 1";
      execOnDvarIntValue r_displayMode 2 "set ui_r_displayMode 2";
    }
    onClose
    {
      setLocalVarBool ui_optionRowShow 0;
      ExecNow "profile_menuDvarsFinish; resetViewport";
      setLocalVarBool ui_hideBack 0;
      execondvarintvalue r_lodScaleRigid 2 "set r_lodScaleSkinned 4; set r_lodBiasSkinned -200; set r_lodBiasRigid -100";
      execondvarintvalue r_lodScaleRigid 1 "set r_lodScaleSkinned 1; set r_lodBiasSkinned 0; set r_lodBiasRigid 0";
      execOnDvarIntValue ui_r_displayMode 0 "seta r_displayMode 0";
      execOnDvarIntValue ui_r_displayMode 1 "seta r_displayMode 1";
      execOnDvarIntValue ui_r_displayMode 2 "seta r_displayMode 2";
    }
    onESC
    {
      close self;
      open iw4x_ingame_main_options;
      if (!(menuisopen("iw4x_ingame_main_options") || menuisopen("iw4x_ingame_pc_options_advanced_video") || menuisopen("iw4x_ingame_pc_options_video") || menuisopen("pc_options_Audio") || menuisopen("iw4x_ingame_pc_options_controls") || menuisopen("iw4x_ingame_pc_options_voice") || menuisopen("iw4x_ingame_pc_options_chat")) && localvarbool("ui_showPicApply") && !localvarbool("ui_showApply") && !localvarbool("ui_showAudioApply"))
      {
        execnow "setfromdvar r_picmip ui_r_picmip";
        execnow "setfromdvar r_picmip_bump ui_r_picmip_bump";
        execnow "setfromdvar r_picmip_spec ui_r_picmip_spec";
        execnow "setfromdvar r_picmip_manual ui_r_picmip_manual";
        exec "wait; wait; r_applyPicmip";
        setLocalVarBool ui_showPicApply 0;
      }
      if (!(menuisopen("iw4x_ingame_main_options") || menuisopen("iw4x_ingame_pc_options_advanced_video") || menuisopen("iw4x_ingame_pc_options_video") || menuisopen("pc_options_Audio") || menuisopen("iw4x_ingame_pc_options_controls") || menuisopen("iw4x_ingame_pc_options_voice") || menuisopen("iw4x_ingame_pc_options_chat")) && (localvarbool("ui_showApply") || localvarbool("ui_showAudioApply")))
      {
        open all_restart_popmenu;
      }
      ExecNow "profile_menuDvarsFinish; resetViewport";
    }
    itemDef
    {
      rect                        -427 -240 854 480 2 2
      style                       3
      decoration
      visible                     when(FUNC_29() && (dvarstring(gameMode) == "mp" || (dvarstring(gameMode) == "so" && !dvarbool(solo_play))));
      textscale                   0.55
      forecolor                   0 0 0 0.4
      background                  "white"
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      background                  "mw2_main_background"
    }
    itemDef
    {
      rect                        0 0 1708 480 0 0
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      forecolor                   1 1 1 0.5
      background                  "mw2_main_cloud_overlay"
      exp rect x                  (0 - 107) - ((float(milliseconds() % 60000) / 60000) * (854));
    }
    itemDef
    {
      rect                        0 0 -1708 -480 0 0
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      forecolor                   1 1 1 0.5
      background                  "mw2_main_cloud_overlay"
      exp rect x                  (- 107 + 854) + ((float(milliseconds() % 50000) / 50000) * (854));
    }
    itemDef
    {
      rect                        -427 -240 854 480 2 2
      style                       3
      decoration
      visible                     when(dvarstring(gameMode) == "sp" && !FUNC_29());
      textscale                   0.55
      background                  "mw2_main_sp_image"
    }
    itemDef
    {
      rect                        -427 -240 854 480 2 2
      style                       3
      decoration
      visible                     when(dvarstring(gameMode) == "so" && !FUNC_29());
      textscale                   0.55
      background                  "mw2_main_co_image"
    }
    itemDef
    {
      rect                        -427 -240 854 480 2 2
      style                       3
      decoration
      visible                     when(dvarstring(gameMode) == "mp" && !FUNC_29());
      textscale                   0.55
      background                  "mw2_main_mp_image"
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     1
      textscale                   0.55
      forecolor                   1 1 1 0
      background                  "mockup_bg_glow"
      exp forecolor a             ((sin(milliseconds() / 1500) + 1) * 0.25) + 0.25;
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     1
      textscale                   0.55
      forecolor                   1 1 1 0
      background                  "mockup_bg_glow"
      exp forecolor a             ((sin(milliseconds() / 480) + 1) * 0.25) + 0.25;
    }
    itemDef
    {
      rect                        -64 0 280 480 1 0
      style                       3
      decoration
      visible                     when(1);
      textscale                   0.55
      forecolor                   1 1 1 0.1
      background                  "gradient_fadein_fadebottom"
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      forecolor                   0.25 0.25 0.25 0.75
      background                  "gradient_fadein"
    }
    itemDef
    {
      rect                        0 0 640 480 4 4
      style                       3
      decoration
      visible                     when(!FUNC_29());
      textscale                   0.55
      forecolor                   0.25 0.25 0.25 0.75
      background                  "gradient_fadein"
    }
    itemDef
    {
      text                        "@PLATFORM_BACK_CAPS"
      group                       "mw2_button"
      rect                        -64 -4 280 20 1 3
      style                       1
      type                        1
      visible                     when(1);
      textalign                   6
      textalignx                  -4
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      background                  "popup_button_selection_bar"
      onFocus
      {
        play mouse_over;
        if (dvarstring(gameMode) != "mp")
        {
          setItemColor mw2_button backcolor 0 0 0 0;
        }
        setItemColor self backcolor 0 0 0 1;
        setLocalVarBool ui_menuAButton 1;
        setLocalVarBool ui_optionRowShow 0;
      }
      leaveFocus
      {
        setItemColor self backcolor 0 0 0 "0.0";
        setLocalVarString ui_hint_text "@NULL_EMPTY";
        setLocalVarBool ui_menuAButton 0;
      }
      action
      {
        play mouse_click;
        play mouse_click;
        escape self;
        if (!(menuisopen("iw4x_ingame_main_options") || menuisopen("iw4x_ingame_pc_options_advanced_video") || menuisopen("iw4x_ingame_pc_options_video") || menuisopen("pc_options_Audio") || menuisopen("iw4x_ingame_pc_options_controls") || menuisopen("iw4x_ingame_pc_options_voice") || menuisopen("iw4x_ingame_pc_options_chat")))
        {
          if (localvarbool("ui_showPicApply") && !localvarbool("ui_showApply"))
          {
            execnow "setfromdvar r_picmip ui_r_picmip";
            execnow "setfromdvar r_picmip_bump ui_r_picmip_bump";
            execnow "setfromdvar r_picmip_spec ui_r_picmip_spec";
            execnow "setfromdvar r_picmip_manual ui_r_picmip_manual";
            exec "wait; wait; r_applyPicmip";
            setLocalVarBool ui_showPicApply 0;
          }
          if (localvarbool("ui_showApply") || localvarbool("ui_showAudioApply"))
          {
            open all_restart_popmenu;
          }
        }
      }
    }
    itemDef
    {
      text                        "@MENU_VIDEO"
      rect                        0 0 272 28 1 1
      decoration
      visible                     1
      textalign                   6
      textalignx                  -60
      textscale                   0.5
      textfont                    9
    }
    itemDef
    {
      rect                        -64 0 280 20 1 1
      style                       3
      decoration
      visible                     when(localvarbool("ui_optionRowShow"));
      textscale                   0.55
      forecolor                   0 0 0 1
      background                  "popup_button_selection_bar"
      exp rect y                  localvarfloat("ui_optionRowY");
    }
    itemDef
    {
      rect                        -64 28 384 20 1 1
      type                        13
      visible                     when(1);
      disabled                    when(dvarint(ui_r_displayMode) == 2 || FUNC_31());
      textalign                   4
      textalignx                  288
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      onFocus
      {
        play mouse_over;
        setLocalVarFloat ui_optionRowY 28;
        setLocalVarBool ui_optionRowShow 1;
      }
      leaveFocus
      {
        setLocalVarBool ui_optionRowShow 0;
      }
      action
      {
        play mouse_click;
        setLocalVarBool ui_showApply 1;
      }
      dvar                        "ui_r_mode"
      dvarEnumList                "r_mode"
    }
    itemDef
    {
      text                        "@MENU_VIDEO_MODE"
      rect                        -64 28 336 20 1 1
      decoration
      visible                     when(1);
      disabled                    when(dvarint(ui_r_displayMode) == 2 || FUNC_31());
      textalign                   6
      textalignx                  -60
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
    }
    itemDef
    {
      rect                        224 71 344 20 1 1
      type                        10
      visible                     when(!cantogglefullscreen());
      textscale                   0.55
      onFocus
      {
        setLocalVarFloat ui_optionRowY 68;
        setLocalVarBool ui_optionRowShow 1;
        play mouse_over;
        setLocalVarBool ui_brightness_hint_display 1;
      }
      leaveFocus
      {
        setLocalVarBool ui_brightness_hint_display 0;
      }
      action
      {
        ExecNow profile_menuDvarsFinish;
      }
      dvarFloat                   "profileMenuOption_Gamma" 1 0.5 1.5
    }
    itemDef
    {
      rect                        -64 48 384 20 1 1
      type                        12
      visible                     when(cantogglefullscreen());
      disabled                    when(FUNC_31());
      textalign                   4
      textalignx                  288
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      onFocus
      {
        play mouse_over;
        setLocalVarFloat ui_optionRowY 48;
        setLocalVarBool ui_optionRowShow 1;
      }
      leaveFocus
      {
        setLocalVarBool ui_optionRowShow 0;
      }
      action
      {
        play mouse_click;
        setLocalVarBool ui_showApply 1;
      }
      dvar                        "ui_r_displayMode"
      dvarFloatList               { "@MENU_IW4X_WINDOWED" 0 "@MENU_FULLSCREEN" 1 "@MENU_IW4X_WINDOWED_FULLSCREEN" 2 }
    }
    itemDef
    {
      text                        "@MENU_IW4X_DISPLAY_MODE"
      rect                        -64 48 336 20 1 1
      decoration
      visible                     when(cantogglefullscreen());
      disabled                    when(FUNC_31());
      textalign                   6
      textalignx                  -60
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
    }
    itemDef
    {
      text                        "@MENU_BRIGHTNESS"
      rect                        -64 68 336 20 1 1
      decoration
      visible                     when(!cantogglefullscreen());
      textalign                   6
      textalignx                  -60
      textscale                   0.375
      textfont                    3
    }
    itemDef
    {
      text                        "@MENU_ADVANCED_VIDEO"
      rect                        -64 108 336 20 1 1
      type                        1
      visible                     when(1);
      disabled                    when(0);
      textalign                   6
      textalignx                  -60
      textscale                   0.375
      textfont                    3
      onFocus
      {
        setLocalVarFloat ui_optionRowY 108;
        setLocalVarBool ui_optionRowShow 1;
      }
      leaveFocus
      {
        setLocalVarBool ui_optionRowShow 0;
      }
      action
      {
        setLocalVarBool ui_optionsFromVideo 1;
        close self;
        open iw4x_ingame_pc_options_advanced_video;
      }
    }
    itemDef
    {
      name                        "graphic_warning"
      text                        "@MENU_GRAPHICS_WARNING"
      rect                        10 -120 206 200 1 3
      style                       1
      decoration
      autowrapped
      type                        1
      visible                     when(!localvarbool("ui_brightness_hint_display"));
      textscale                   0.375
    }
    itemDef
    {
      name                        "brightness_hint"
      text                        "@MENU_BRIGHTNESS_HINT_PC"
      rect                        10 -120 206 200 1 3
      style                       1
      decoration
      autowrapped
      type                        1
      visible                     when(localvarbool("ui_brightness_hint_display"));
      textscale                   0.375
      forecolor                   1 0.8 0.4 1
    }
  }
}
