    }
    itemDef
    {
      text                        "Nobody by that name has played on IW4x."
      rect                        4 170 452 20 0 0
      style                       1
      decoration
      visible                     when(dvarbool(ui_friend_asked) && !dvarbool(ui_friend_searching) && (dvarint(ui_friend_found) == 0) && (dvarstring(ui_friend_filter) == ""));
      textalign                   1
      textalignx                  0
      textscale                   0.3
      textfont                    3
      forecolor                   1 1 1 0.5
    }
    itemDef
    {
      text                        "Nothing here matches that filter."
      rect                        4 170 452 20 0 0
      style                       1
      decoration
      visible                     when(dvarbool(ui_friend_asked) && !dvarbool(ui_friend_searching) && (dvarint(ui_friend_found) == 0) && (dvarstring(ui_friend_filter) != ""));
      textalign                   1
      textalignx                  0
      textscale                   0.3
      textfont                    3
      forecolor                   1 1 1 0.5
    }
    itemDef
    {
      text                        "Double-click someone to send them a request."
      rect                        4 284 452 16 0 0
      style                       1
      decoration
      visible                     when(dvarbool(ui_friend_asked) && !dvarbool(ui_friend_searching) && dvarint(ui_friend_found) > 0 && dvarstring(ui_friends_note) == "");
      textalign                   1
      textalignx                  0
      textscale                   0.25
      textfont                    3
      forecolor                   1 1 1 0.4
    }
    itemDef
    {
      rect                        4 284 452 16 0 0
      style                       1
      decoration
      visible                     when(dvarstring(ui_friends_note) != "");
      textalign                   1
      textalignx                  0
      textscale                   0.25
      textfont                    3
      forecolor                   1 0.8 0.35 1
      exp text                    dvarstring(ui_friends_note);
    }
    itemDef
    {
      name                        "friend_send"
      group                       "mw2_popup_button"
      rect                        4 304 452 20 0 0
      style                       1
      type                        1
      visible                     when(dvarbool(ui_friend_asked) && !dvarbool(ui_friend_searching) && dvarint(ui_friend_found) > 0);
      disabled                    when(!dvarbool(ui_friend_cansend));
      textalign                   6
      textalignx                  -24
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      background                  "popup_button_selection_bar"
      onFocus
