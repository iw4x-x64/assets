        setItemColor self backcolor 1 1 1 0;
        setLocalVarBool ui_popupAButton 0;
      }
      action
      {
        play mouse_click;
        exec "friend_send";
      }
      exp text                    "Send Request To " + dvarstring(ui_friend_pick);
    }
