    itemDef
    {
      name                        "friend_name_entry"
      text                        " "
      rect                        4 44 340 20 0 0
      style                       1
      type                        4
      visible                     when(1);
      textalign                   8
      textscale                   0.375
      textfont                    3
      backcolor                   0 0 0 0.3
      forecolor                   0.9 0.9 0.9 1
      accept
      {
        exec "friend_add";
      }
      dvar                        "ui_friend_add"
      maxChars                    31
      maxPaintChars               31
    }
    itemDef
    {
      name                        "friend_look"
      text                        "Search"
      group                       "mw2_popup_button"
      rect                        348 44 108 20 0 0
      style                       1
      type                        1
      visible                     1
      disabled                    when(dvarstring(ui_friend_add) == "");
      textalign                   6
      textalignx                  -12
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      background                  "popup_button_selection_bar"
      onFocus
      {
        play mouse_over;
        if (dvarstring(gameMode) != "mp")
        {
          setItemColor mw2_popup_button backcolor 0 0 0 0;
        }
        setItemColor self backcolor 0 0 0 1;
        setLocalVarBool ui_popupAButton 1;
      }
      leaveFocus
      {
        setItemColor self backcolor 1 1 1 0;
        setLocalVarBool ui_popupAButton 0;
      }
      action
      {
        play mouse_click;
        exec "friend_add";
      }
    }
