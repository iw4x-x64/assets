{
  menuDef
  {
    name                        "popup_friend_options"
    rect                        -150 -62 300 124 2 2
    style                       1
    backcolor                   1 1 1 1
    focuscolor                  1 1 1 1
    background                  "white"
    popup
    legacySplitScreenScale
    visible                     1
    onOpen
    {
      setLocalVarInt ui_centerPopup 1;
      setFocus friend_primary;
      if (!dvarbool(ui_friend_haspri))
      {
        setFocus friend_secondary;
      }
    }
    onClose
    {
      setLocalVarInt ui_centerPopup 0;
    }
    onESC
    {
      close self;
    }
    itemDef
