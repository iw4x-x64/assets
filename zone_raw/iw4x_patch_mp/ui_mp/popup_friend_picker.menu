    itemDef
    {
      text                        "Double-click a friend to tick them, then choose Invite."
      rect                        4 24 452 16 0 0
      style                       1
      decoration
      visible                     1
      textalign                   2
      textalignx                  -4
      textscale                   0.25
      textfont                    3
      forecolor                   1 1 1 0.5
    }
    itemDef
    {
      name                        "pickerlist"
      rect                        4 44 452 260 0 0
      type                        6
      visible                     1
      textaligny                  -2
      textscale                   0.375
      textfont                    3
      forecolor                   1 1 1 1
      outlinecolor                0.9 0.9 0.95 0.175
      elementwidth                452
      elementheight               20
      feeder                      101
      columns                     2
                                  8 300 32 0
                                  316 130 24 0
      doubleclick
      {
        play mouse_click;
        exec "friend_pick_toggle";
      }
    }
    itemDef
    {
      name                        "picker_confirm"
      group                       "mw2_popup_button"
      rect                        4 308 452 20 0 0
      style                       1
      type                        1
      visible                     1
      disabled                    when(dvarint(ui_friend_ticked) == 0);
      textalign                   6
      textalignx                  -24
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      background                  "popup_button_selection_bar"
      onFocus
      {
        play mouse_over;
        if (dvarstring(gameMode) != "mp")
        {
          setItemColor mw2_popup_button backcolor 0 0 0 0;
        }
        setItemColor self backcolor 0 0 0 1;
        setLocalVarBool ui_popupAButton 1;
      }
      leaveFocus
      {
        setItemColor self backcolor 1 1 1 0;
        setLocalVarBool ui_popupAButton 0;
      }
      action
      {
        play mouse_click;
        exec "friend_pick_confirm";
        close self;
      }
      exp text                    "Invite (" + dvarint(ui_friend_ticked) + ")";
    }
    itemDef
    {
      name                        "picker_cancel"
      text                        "@MENU_CANCEL"
      group                       "mw2_popup_button"
      rect                        4 328 452 20 0 0
      style                       1
      type                        1
      visible                     1
      textalign                   6
      textalignx                  -24
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
