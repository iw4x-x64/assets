    background                  "white"
    popup
    legacySplitScreenScale
    visible                     1
    onOpen
    {
      setLocalVarInt ui_centerPopup 1;
      setFocus pickerlist;
    }
    onClose
    {
      setLocalVarInt ui_centerPopup 0;
      exec "friend_pick_cancel";
    }
    onESC
