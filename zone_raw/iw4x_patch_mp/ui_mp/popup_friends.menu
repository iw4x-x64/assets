        }
        setItemColor self backcolor 0 0 0 1;
        setLocalVarBool ui_popupAButton 1;
      }
      leaveFocus
      {
        setItemColor self backcolor 1 1 1 0;
        setLocalVarBool ui_popupAButton 0;
      }
      action
      {
