    itemDef
    {
      name                        "discord_link"
      text                        "Link Discord"
      group                       "mw2_popup_button"
      rect                        4 380 452 20 0 0
      style                       1
      type                        1
      visible                     when(dvarint(ui_friends_tab) == 1 && dvarint(ui_discord_state) <= 1);
      disabled                    when(dvarint(ui_discord_state) == 0);
      textalign                   6
      textalignx                  -24
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      background                  "popup_button_selection_bar"
      onFocus
      {
