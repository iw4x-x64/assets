{
  menuDef
  {
    name                        "popup_friends"
    rect                        -230 -212 460 424 2 2
    style                       1
    backcolor                   1 1 1 1
    focuscolor                  1 1 1 1
    background                  "white"
    popup
    legacySplitScreenScale
    visible                     1
    onOpen
    {
      setLocalVarInt ui_centerPopup 1;
      exec "friends_open";
      setFocus friendslist;
      if (dvarint(ui_friends_tab) == 1)
      {
        setFocus discordlist;
      }
      if (dvarint(ui_friends_tab) == 0 && dvarint(ui_friends_waiting) > 0)
      {
        setFocus pendinglist;
      }
    }
    onClose
    {
      setLocalVarInt ui_centerPopup 0;
    }
    onESC
    {
      close self;
    }
