      visible                     when(dvarint(ui_friends_tab) == 1 && dvarint(ui_discord_state) >= 2);
      textalign                   6
      textalignx                  -24
      textscale                   0.375
      textfont                    3
      disablecolor                0.6 0.55 0.55 1
      background                  "popup_button_selection_bar"
      onFocus
      {
        play mouse_over;
        if (dvarstring(gameMode) != "mp")
        {
